<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>My API Keys</h1>
  <%= link_to "Create New API Key", new_api_key_path, class: "btn btn-primary" %>
</div>

<% if flash[:api_key_token] %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <h5 class="alert-heading"><i class="bi bi-check-circle-fill"></i> API Key Created Successfully</h5>
    <p class="mb-2">Your new API key has been created. <strong>Copy it now - you won't be able to see it again!</strong></p>
    <div class="input-group mb-3">
      <input type="text" class="form-control font-monospace" value="<%= flash[:api_key_token] %>" id="apiKeyToken" readonly>
      <button class="btn btn-outline-secondary" type="button" onclick="copyApiKey()">
        <i class="bi bi-clipboard"></i> Copy
      </button>
    </div>
    <hr>
    <p class="mb-0">
      <strong>Usage:</strong> Include this key in your API requests using the Authorization header:<br>
      <code>Authorization: Bearer <%= flash[:api_key_token] %></code>
    </p>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<div class="card shadow-sm">
  <div class="card-body">
    <% if @api_keys.any? %>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Name</th>
              <th>Created</th>
              <th>Last Used</th>
              <th>Expires</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @api_keys.each do |api_key| %>
              <tr>
                <td>
                  <strong><%= api_key.name %></strong>
                </td>
                <td>
                  <%= time_ago_in_words(api_key.created_at) %> ago
                </td>
                <td>
                  <% if api_key.last_used_at %>
                    <%= time_ago_in_words(api_key.last_used_at) %> ago
                  <% else %>
                    <span class="text-muted">Never</span>
                  <% end %>
                </td>
                <td>
                  <% if api_key.expires_at %>
                    <% if api_key.expired? %>
                      <span class="badge bg-danger">Expired <%= time_ago_in_words(api_key.expires_at) %> ago</span>
                    <% else %>
                      in <%= api_key.expires_in_days %> days
                    <% end %>
                  <% else %>
                    <span class="text-muted">Never</span>
                  <% end %>
                </td>
                <td>
                  <% if api_key.valid_key? %>
                    <span class="badge bg-success">Active</span>
                  <% elsif api_key.expired? %>
                    <span class="badge bg-danger">Expired</span>
                  <% else %>
                    <span class="badge bg-secondary">Inactive</span>
                  <% end %>
                </td>
                <td>
                  <%= button_to "Revoke", api_key_path(api_key), method: :delete, 
                      class: "btn btn-sm btn-danger",
                      data: { confirm: "Are you sure you want to revoke this API key? This action cannot be undone." } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-key" style="font-size: 3rem; color: #ccc;"></i>
        <h5 class="mt-3 text-muted">No API Keys</h5>
        <p class="text-muted">You haven't created any API keys yet.</p>
        <%= link_to "Create Your First API Key", new_api_key_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-4">
  <h3>About API Keys</h3>
  <p>API keys allow you to authenticate with the Crystal Plates API programmatically. Each key can be used to make requests on your behalf with your current permissions (<strong><%= current_user.role.titleize %></strong>).</p>
  
  <div class="alert alert-info">
    <h6><i class="bi bi-info-circle"></i> Security Best Practices</h6>
    <ul class="mb-0">
      <li>Never share your API keys with others</li>
      <li>Use different API keys for different applications or services</li>
      <li>Set expiration dates for API keys when possible</li>
      <li>Revoke API keys immediately if they are compromised</li>
      <li>Rotate your API keys regularly</li>
    </ul>
  </div>
</div>

<script>
function copyApiKey() {
  const input = document.getElementById('apiKeyToken');
  input.select();
  document.execCommand('copy');
  
  const button = event.target.closest('button');
  const originalHTML = button.innerHTML;
  button.innerHTML = '<i class="bi bi-check"></i> Copied!';
  button.classList.remove('btn-outline-secondary');
  button.classList.add('btn-success');
  
  setTimeout(() => {
    button.innerHTML = originalHTML;
    button.classList.remove('btn-success');
    button.classList.add('btn-outline-secondary');
  }, 2000);
}
</script>
